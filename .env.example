# Firebase web app values
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin service-account JSON; keep server-side only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Generate a strong random secret for OTP digesting.
OTP_HASH_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SureFood

# Cloudinary credentials; never expose the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Smile ID Business Verification: server-only credentials. The callback URL must be public HTTPS.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=
SMILE_ID_ENVIRONMENT=sandbox

# Paystack server-side secret key. Use a test key for local development.
PAYSTACK_SECRET_KEY=
# Local staff/admin override email for demo access to the verification admin page.
SURFOOD_ADMIN_EMAIL=admin@surefood.test
# Set a random secret of at least 32 characters for first-time admin account setup.
SUREFOOD_ADMIN_SETUP_KEY=
# Public HTTPS app URL for Paystack callbacks (use http://localhost:3000 locally).
APP_BASE_URL=http://localhost:3000
